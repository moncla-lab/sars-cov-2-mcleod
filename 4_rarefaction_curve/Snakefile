"""This file specifies the entire pipeline that will be run, with
specific parameters for subsampling, tree building, and visualization. In this
build, you will generate 1 tree: an mcleod tree, using sequences sampled from the sars-cov-2 pandemic."""

"""Here, define your wildcards. To include more subtypes or gene segments, simply
add those to these lists, separated by commas"""
num_seqs = [50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600, 650, 700]
trials = [1,2,3,4,5]

##adding date here
from datetime import date
TODAYS_DATE = str(date.today())

"""This rule tells Snakemake that at the end of the pipeline, you should have
generated JSON files in the auspice folder for each subtype and segment."""
rule all:
    input:
        expand(
            "results/clusters_{num_seqs}_seqs_trial_{trials}/{date}_tipcounts_parsedon_TCstatus.tsv",
            num_seqs=num_seqs,
            trials=trials,
            date=TODAYS_DATE
        ),
        "results/transitions_summary.tsv" 
        
# ##changing rule all to be the final output from new cluster rule
        
"""Specify all input files here. For this build, you'll start with input sequences
from the data folder, which contain metadata information in the
sequence header. Specify here files denoting specific strains to include or drop,
references sequences, and files for auspice visualization (colors)"""

rule files:
    params:
        mcleod_seqs_fasta = "data/mcleod_{num_seqs}_seqs_trial_{trials}.fasta", 
        background_seqs_fasta = "data/background.fasta",
        input_metadata = "data/2_8_more_greatermn_tc_om_meta.tsv",
        reference = "config/reference.gb",
        auspice_config = "config/auspice_config.json",
        dropped_strains = "config/exclude_strains.txt",
        colors = "config/colors.tsv",
        date = TODAYS_DATE  # define this at the top of your Snakefile as: from datetime import date; TODAYS_DATE = str(date.today())



files = rules.files.params


