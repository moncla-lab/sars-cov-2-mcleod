"""This rule specifies how to subsample data for the build, which is highly
customizable based on your desired tree. A few notes on specifics on the
subsampling arguments here:

1. include: all strain names specified in this include file will be force included
in the build.
2. exclude: all strain names specified in this exclude file will be subsampled
out of the build.
3. min_date: sequences with collection dates before this time will be removed
4. min_length: sequences with lengths less than this value will be removed
5. group_by and sequences_per_group: these 2 arguments are used in conjunction with
one another to set how many sequences should be sampled. Whichever columns you
specify in group_by will be used to generate subsets of the data by those groups.
For example, if you specify "year host", Nextstrain will generate 1 group per
combation of year and host (e.g., "2000 dog", "2000 horse", "2001 dog", "2001 horse",
etc...). Then, from each of those groups, it will sample, at random, the number
of sequences specified in the "group_by" specification.

"""

# rule filter:
#     message:
#         """
#         Filtering to
#           - {params.max_sequences} sequence(s) per {params.group_by!s}
#           - excluding strains in {input.exclude}
#           - samples with missing region and country metadata
#           - excluding strains prior to {params.min_date}
#         """
#     input:
#         sequences = rules.concatenate_fastas.output.full_fasta,
#         metadata = files.input_metadata,
#         exclude = files.dropped_strains
#     output:
#         sequences = "results/filtered_{num_seqs}_seqs_trial_{trials}.fasta"
#     params:
#         group_by = "year",
#         max_sequences = "20",
#         min_date = "2020-01-01",
#         min_length = "27000",
#         exclude_where = "TC_status!='mcleod'"   
#     shell:
#         """
#         augur filter \
#             --sequences {input.sequences} \
#             --metadata {input.metadata} \
#             --exclude {input.exclude} \
#             --output {output.sequences} \
#             --group-by {params.group_by} \
#             --subsample-max-sequences {params.max_sequences} \
#             --min-date {params.min_date} \
#             --exclude-where {params.exclude_where} \
#             --min-length {params.min_length} \
#             --non-nucleotide
#         """
        
rule filter_nonMN:
    message:
        """
        Filtering to
          - {params.max_sequences} sequence(s) per {params.group_by!s}
          - samples with missing region and country metadata
          - excluding strains prior to {params.min_date}
        """
    input:
        sequences = files.background_seqs_fasta,
        metadata = files.input_metadata, 
        exclude = files.dropped_strains
    output:
        sequences = "results/filtered_nonMN_{num_seqs}_seqs_trial_{trials}.fasta"
    params:
        group_by = "year",
        max_sequences = "2000",
        min_date = "2020",
        min_length = "27000",
        exclude_where = "TC_status!='non-MN'"
    shell:
        """
        augur filter \
            --sequences {input.sequences} \
            --metadata {input.metadata} \
            --exclude {input.exclude} \
            --output {output.sequences} \
            --group-by {params.group_by} \
            --subsample-max-sequences {params.max_sequences} \
            --min-date {params.min_date} \
            --exclude-where {params.exclude_where} \
            --min-length {params.min_length} \
            --non-nucleotide
        """
        
rule filter_greaterMN:
    message:
        """
        Filtering to
          - {params.max_sequences} sequence(s) per {params.group_by!s}
          - samples with missing region and country metadata
          - excluding strains prior to {params.min_date}
        """
    input:
        sequences = files.background_seqs_fasta,
        metadata = files.input_metadata, 
        exclude = files.dropped_strains
    output:
        sequences = "results/filtered_greaterMN_{num_seqs}_seqs_trial_{trials}.fasta"
    params:
        group_by = "year",
        max_sequences = "2000",
        min_date = "2020",
        min_length = "27000",
        exclude_where = "TC_status!='greater-MN'"
    shell:
        """
        augur filter \
            --sequences {input.sequences} \
            --metadata {input.metadata} \
            --exclude {input.exclude} \
            --output {output.sequences} \
            --group-by {params.group_by} \
            --subsample-max-sequences {params.max_sequences} \
            --min-date {params.min_date} \
            --exclude-where {params.exclude_where} \
            --min-length {params.min_length} \
            --non-nucleotide
        """
        
rule filter_TC_county:
    message:
        """
        Filtering to
          - {params.max_sequences} sequence(s) per {params.group_by!s}
          - samples with missing region and country metadata
          - excluding strains prior to {params.min_date}
        """
    input:
        sequences = files.background_seqs_fasta,
        metadata = files.input_metadata, 
        exclude = files.dropped_strains
    output:
        sequences = "results/filtered_TC_county_{num_seqs}_seqs_trial_{trials}.fasta"
    params:
        group_by = "year",
        max_sequences = "2000",
        min_date = "2020",
        min_length = "27000",
        exclude_where = "TC_status!='TC_county'"
    shell:
        """
        augur filter \
            --sequences {input.sequences} \
            --metadata {input.metadata} \
            --exclude {input.exclude} \
            --output {output.sequences} \
            --group-by {params.group_by} \
            --subsample-max-sequences {params.max_sequences} \
            --min-date {params.min_date} \
            --exclude-where {params.exclude_where} \
            --min-length {params.min_length} \
            --non-nucleotide
        """

rule merge_filters:
    message: "Merging McLeod, non-MN, TC_county, and greater-MN data."
    input:
        sequences = [rules.filter_nonMN.output.sequences, rules.filter_greaterMN.output.sequences, rules.filter_TC_county.output.sequences]
    output: 
        sequences = 'results/filtered_merged_{num_seqs}_seqs_trial_{trials}.fasta'
    shell:
        """
        cat {input.sequences} > {output.sequences}

        """

rule concatenate_fastas:
    message: "concatenating subsampled mcleod sequences with background sequences."
    input:
        mcleod_sequences = files.mcleod_seqs_fasta,
        background_sequences = rules.merge_filters.output.sequences
    output:
        full_fasta = "results/mcleod-and-background-seqs_{num_seqs}_seqs_trial_{trials}.fasta"
    shell:
        """
        cat {input.mcleod_sequences} {input.background_sequences} > {output.full_fasta}
        """

rule align:
    message:
        """
        Aligning sequences to {input.reference}
          - filling gaps with N
        """
    input:
        sequences = rules.concatenate_fastas.output.full_fasta,
        reference = files.reference
    output:
        alignment = "results/aligned_{num_seqs}_seqs_trial_{trials}.fasta"
    shell:
        """
        augur align \
            --sequences {input.sequences} \
            --reference-sequence {input.reference} \
            --output {output.alignment} \
            --remove-reference \
            --nthreads 1
        """


rule tree:
    message: "Building tree"
    input:
        alignment = rules.align.output.alignment
    output:
        tree = "results/tree-raw_{num_seqs}_seqs_trial_{trials}.nwk"
    params:
        method = "iqtree"
    shell:
        """
        augur tree \
            --alignment {input.alignment} \
            --output {output.tree} \
            --method {params.method} \
            --nthreads 1
        """        


